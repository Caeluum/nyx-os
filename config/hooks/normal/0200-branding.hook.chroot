#!/bin/sh
set -eu

cat > /etc/os-release << 'OSREL'
PRETTY_NAME="NyxOS 13"
NAME="NyxOS"
VERSION_ID="13"
VERSION="13 (Trixie)"
VERSION_CODENAME=trixie
ID=nyxos
ID_LIKE=debian
LOGO=distributor-logo-nyxos
HOME_URL="https://github.com/Caeluum/nyx-os/"
SUPPORT_URL="https://github.com/Caeluum/nyx-os/"
BUG_REPORT_URL="https://github.com/Caeluum/nyx-os/issues"
OSREL

cp /etc/os-release /usr/lib/os-release

# NyxOS naming in desktop entries
for f in /usr/share/applications/calamares.desktop /etc/skel/Desktop/*.desktop /usr/share/applications/*calamares*.desktop; do
    [ -f "$f" ] && sed -i 's/Install Debian/Install NyxOS/g; s/Debian/NyxOS/g' "$f"
done

# Calamares branding
if [ -f /etc/calamares/settings.conf ]; then
    sed -i 's/branding: debian/branding: nyxos/' /etc/calamares/settings.conf
fi

# GRUB branding
if [ -f /etc/default/grub ]; then
    if grep -q '^GRUB_DISTRIBUTOR=' /etc/default/grub; then
        sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="NyxOS"/' /etc/default/grub
    else
        printf '%s\n' 'GRUB_DISTRIBUTOR="NyxOS"' >> /etc/default/grub
    fi
fi

# Make the NyxOS logo available to apps that look in pixmaps.
mkdir -p /usr/share/pixmaps
ln -sf /usr/share/icons/hicolor/scalable/apps/distributor-logo-nyxos.svg \
    /usr/share/pixmaps/distributor-logo-nyxos.svg

# Refresh icon cache when the helper is available.
command -v gtk-update-icon-cache >/dev/null 2>&1 && \
    gtk-update-icon-cache -f /usr/share/icons/hicolor || true
